WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_FORECAST_DAYS=3
WEATHER_MAX_PRECIPITATION=1
WEATHER_MAX_WIND_SPEED_KMH=30

NODE_ENV=production
PORT=3000
REQUEST_TIMEOUT_MS=5000
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
JSON_BODY_LIMIT=2mb
URL_ENCODED_BODY_LIMIT=10kb

POSTGRES_DB=appdb
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me_locally

PGHOST=localhost
PGPORT=5432
PGDATABASE=appdb
PGUSER=app
PGPASSWORD=change_me_locally
